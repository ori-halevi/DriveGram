<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>drivegram</AssemblyName>
    <RootNamespace>DriveGram.App</RootNamespace>
    <Version>1.1.0</Version>
    <ApplicationIcon>..\..\assets\drivegram.ico</ApplicationIcon>
    <!-- the tray app lands in the same folder, so autostart / the drive icon have one place to point at -->
    <OutputPath>..\..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DriveGram.Host\DriveGram.Host.csproj" />
  </ItemGroup>

</Project>
