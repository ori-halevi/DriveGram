<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageReference Include="winfsp.net" Version="2.1.25156" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DriveGram.Core\DriveGram.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\*.ico" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
